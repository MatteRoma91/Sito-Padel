# Porta (default 3000)
PORT=3000

# Segreto per la sessione (produzione: usare stringa lunga e casuale)
SESSION_SECRET=your_secret_at_least_32_characters_long

# Percorso database SQLite
DATABASE_PATH=data/padel.db

# URL pubblico (per PWA e meta)
NEXT_PUBLIC_SITE_URL=https://bananapadeltour.duckdns.org

# --- Web Push (opzionale) ---
# Generare con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto per il push service (es. mailto:...)
VAPID_SUBJECT=mailto:banana-padel@localhost

# --- Cron HTTP (opzionale ma consigliato in prod) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Rate limit Upstash (opzionale) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_PREFIX=padel:rl:
